diagram  theme: dark

// Green is written down somewhere Ensemble reads and checks it; amber is
// read off a name or a path, or only agreed upon.
style explicit    fill: #142814  border: #486544
style convention  fill: #2b1d0e  border: #d2904e
style aside       text: (size: small, color: muted)
style invisible   fill: none  border: none

node title "What a deploy runs for an app" (size: large)  shape: none

node key ""  style: invisible  right of title  gap: wide
node key.explicit    "explicit — written in the manifest, / config.yaml or the code"  style: explicit
node key.convention  "convention — read off a name / or a path, or only agreed on"  style: convention

node ship    "A release ships app server / ci/<name>/delivery.yml, its ship file"  style: explicit  below title  gap: wide
node kit     "The kit deploying it / config.yaml's deploy.<name>.kit, or -k"  style: explicit  below ship

node library  "build.server / has integrations?"  shape: circle  style: explicit  below kit
node program  "Build the app itself / build.server.kit — a program"  style: explicit  left of library  gap: wide  level with library

node declared "integrations / .<kit>?"  shape: circle  style: explicit  below library
node refused  "Error — a library / with none for this kit"  shape: document  style: explicit  left of declared  gap: wide  level with declared

node kitbox  "Its build kit, as configured / node on aws, worker on cloudflare"  style: explicit  below declared
node build   "main.ts becomes main.js, both named by core / in source/integrations/<kit>/server"  style: convention  below kitbox
node bundle  "A bundle whose main.js default-exports / { fetch(request, env) } — function.v1"  shape: document  style: explicit  below build
node run     "The kit runs it: aws adds its Lambda adapter, / cloudflare runs it as a Worker"  style: explicit  below bundle

node code "What the integration imports (project code)"  right of library and bundle  gap: wide
node code.main      "integrations/<kit>/server/main.ts / builds the ports from env"  style: convention
node code.app       "apps/server / new Api(ports).fetch(request)"  style: convention  below code.main
node code.adapters  "@ensemble-adapters/ / <provider>-<tech>"  style: convention  right of code.app  level with code.app
node code.core      "@ensemble-adapters/core / Table, Bucket: the ports"  style: convention  below code.app and code.adapters

node unchecked "Of this side Ensemble checks only the bundle it builds into. The app's shape and the adapters' names are the project's own convention." (wrap: 46)  style: aside  shape: none  below code  gap: tight

node both "kit and integrations together, or neither, is an error: / an app is a program or a library, never both"  shape: document  style: explicit  right of library  gap: wide  level with library

edge ship -> kit
edge kit -> library
edge library -> program  "no"  from: left  to: right
edge library -> declared  "yes"
edge declared -> refused  "no"  from: left  to: right
edge declared -> kitbox  "yes"
edge kitbox -> build
edge build -> bundle
edge program -> bundle  "its own main.js"  from: bottom  to: left  left of refused
edge bundle -> run

edge library -> both  "checked first"  (size: small, color: muted)  line: (pattern: dashed)  from: right  to: left

edge code.main -> code.app  "package.json"  (size: small, color: muted)
edge code.main -> code.adapters  from: right  to: top
edge code.app -> code.core
edge code.adapters -> code.core
edge code -> build  "built from"  (size: small, color: muted)  line: (pattern: dashed)  from: left  to: right
