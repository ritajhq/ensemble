diagram  theme: dark
default edge  line: (path: square)
style external  fill: #2b1d0e  border: #d2904e
style muted  text: (color: theme-muted)
style network_0  fill: #2b1d0e  border: #d2904e
style network_1  fill: #0f2a2a  border: #4aa3a3
style network_2  fill: #20172e  border: #9a7bc4
style network_3  fill: #2b1420  border: #c46a8a
style compute_0  border: #e06c75  line: #e06c75
style compute_1  border: #61afef  line: #61afef
style compute_2  border: #98c379  line: #98c379
style compute_3  border: #e5c07b  line: #e5c07b
style compute_4  border: #c678dd  line: #c678dd
style compute_5  border: #56b6c2  line: #56b6c2
style compute_6  border: #d19a66  line: #d19a66
icon compute-container """
