# Local development values for `ens develop platform`, which loads this file
# and the untracked .ensemble/deploy/platform/secrets.env by default (`ens
# deploy` reads them only via --env-file). Values already exported win.
#
# The hosts the platform answers on, under a domain that resolves to 127.0.0.1
# (lvh.me and every name beneath it does), reached through the local proxy
# `ens develop` starts. A domain of its own: another stack that serves lvh.me
# itself (the portal) would otherwise share its wildcard with this one.
preview_domain=ensemble.lvh.me
platform_host=platform.ensemble.lvh.me
auth_host=auth.ensemble.lvh.me
