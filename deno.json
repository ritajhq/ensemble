{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "types": [
      "npm:@types/react@19",
      "npm:@types/react-dom@19"
    ]
  },
  "unstable": [
    "kv"
  ],
  "workspace": [
    "source/apps/**",
    "source/core/**",
    "source/libs/**",
    ".ensemble/kits/**"
  ],
  "tasks": {
    "cli": "deno run -A source/apps/cli/main.ts",
    "compile": "deno compile -A --include source/core/workflow/run-script-subprocess.ts --output .ensemble/bin/ens source/apps/cli/main.ts",
    "server": "deno run -A source/apps/server/main.ts"
  }
}