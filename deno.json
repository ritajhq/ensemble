{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "types": [
      "npm:@types/react@19",
      "npm:@types/react-dom@19"
    ]
  },
  "unstable": [
    "kv"
  ],
  "imports": {
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/yaml": "jsr:@std/yaml@1.1.2",
    "@david/dax": "jsr:@david/dax@0.42.0"
  },
  "workspace": [
    "source/apps/**",
    "source/core/**",
    "source/libs/**",
    ".ensemble/kits/**"
  ],
  "tasks": {
    "cli": "deno run -A source/apps/cli/main.ts",
    "compile": "deno compile -A --output .ensemble/bin/ens source/apps/cli/main.ts"
  }
}