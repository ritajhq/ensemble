{
  "name": "ensemble-cli",
  "displayName": "Ensemble Workspace",
  "description": "Ensemble workspace support, powered by the ens CLI.",
  "version": "0.0.1",
  "publisher": "ritaj",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ritajhq/ensemble.git"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "ensemble",
    "ens",
    "delivery",
    "deploy",
    "yaml"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./main.js",
  "activationEvents": [
    "workspaceContains:ci/*/delivery.yml",
    "workspaceContains:ci/*/delivery"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ensemble.hello",
        "title": "Hello",
        "category": "Ensemble"
      }
    ],
    "languages": [
      {
        "id": "yaml",
        "filenamePatterns": [
          "**/ci/*/delivery"
        ]
      }
    ]
  }
}
