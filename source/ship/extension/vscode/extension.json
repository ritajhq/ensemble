{
  "name": "ensemble-cli",
  "displayName": "Ensemble Workspace",
  "description": "Ensemble workspace support, powered by the ens CLI.",
  "version": "0.0.1",
  "publisher": "ritaj",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ritajhq/ensemble.git"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "ensemble",
    "ens",
    "delivery",
    "deploy",
    "yaml"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./main.js",
  "activationEvents": [
    "workspaceContains:ci/*/delivery.yml",
    "workspaceContains:ci/*/delivery"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ensemble.refresh",
        "title": "Refresh Project",
        "category": "Ensemble",
        "icon": "$(refresh)"
      },
      {
        "command": "ensemble.build",
        "title": "Build App",
        "category": "Ensemble",
        "icon": "$(play)"
      },
      {
        "command": "ensemble.develop",
        "title": "Develop Workload",
        "category": "Ensemble",
        "icon": "$(play)"
      },
      {
        "command": "ensemble.deploy",
        "title": "Deploy Workload\u2026",
        "category": "Ensemble",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ensemble.release",
        "title": "Release\u2026",
        "category": "Ensemble",
        "icon": "$(tag)"
      },
      {
        "command": "ensemble.kit.new",
        "title": "New Kit\u2026",
        "category": "Ensemble",
        "icon": "$(add)"
      },
      {
        "command": "ensemble.kit.install",
        "title": "Install Kit\u2026",
        "category": "Ensemble",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ensemble.kit.update",
        "title": "Update Kit\u2026",
        "category": "Ensemble",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ensemble.kit.pin",
        "title": "Pin Kit\u2026",
        "category": "Ensemble",
        "icon": "$(pin)"
      },
      {
        "command": "ensemble.kit.contribute",
        "title": "Contribute Kit Changes Upstream",
        "category": "Ensemble",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "ensemble.kit.eject",
        "title": "Eject Kit to Its Own Repository\u2026",
        "category": "Ensemble",
        "icon": "$(export)"
      },
      {
        "command": "ensemble.lib.new",
        "title": "New Library\u2026",
        "category": "Ensemble",
        "icon": "$(add)"
      },
      {
        "command": "ensemble.lib.install",
        "title": "Install Library\u2026",
        "category": "Ensemble",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ensemble.lib.update",
        "title": "Update Library\u2026",
        "category": "Ensemble",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ensemble.lib.pin",
        "title": "Pin Library\u2026",
        "category": "Ensemble",
        "icon": "$(pin)"
      },
      {
        "command": "ensemble.lib.contribute",
        "title": "Contribute Library Changes Upstream",
        "category": "Ensemble",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "ensemble.lib.eject",
        "title": "Eject Library to Its Own Repository",
        "category": "Ensemble",
        "icon": "$(export)"
      },
      {
        "command": "ensemble.lib.publish",
        "title": "Publish Library\u2026",
        "category": "Ensemble",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ensemble.updateCli",
        "title": "Update the Ensemble CLI",
        "category": "Ensemble",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ensemble.kit.uninstall",
        "title": "Uninstall Kit",
        "category": "Ensemble",
        "icon": "$(trash)"
      },
      {
        "command": "ensemble.lib.uninstall",
        "title": "Uninstall Library",
        "category": "Ensemble",
        "icon": "$(trash)"
      }
    ],
    "languages": [
      {
        "id": "yaml",
        "filenamePatterns": [
          "**/ci/*/delivery"
        ]
      }
    ],
    "configuration": {
      "title": "Ensemble",
      "properties": {
        "ensemble.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `ens` binary. When empty, the extension uses `~/.ensemble/bin/ens` (where the installer puts it) if present, otherwise `ens` on the `PATH`. Reload the window after changing it."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ensemble",
          "title": "Ensemble",
          "icon": "media/ensemble.svg"
        }
      ]
    },
    "views": {
      "ensemble": [
        {
          "id": "ensemble.project",
          "name": "Project",
          "contextualTitle": "Ensemble"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ensemble.project",
        "contents": "Open an Ensemble project (a folder with .ensemble/config.yaml) to see its apps, workloads, kits and libraries.\n[Read about Ensemble](https://github.com/ritajhq/ensemble)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ensemble.refresh",
          "when": "view == ensemble.project",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ensemble.build",
          "when": "view == ensemble.project && viewItem == app",
          "group": "inline"
        },
        {
          "command": "ensemble.develop",
          "when": "view == ensemble.project && viewItem == workload",
          "group": "inline"
        },
        {
          "command": "ensemble.deploy",
          "when": "view == ensemble.project && viewItem == workload",
          "group": "inline"
        },
        {
          "command": "ensemble.release",
          "when": "view == ensemble.project && viewItem == section.workloads",
          "group": "inline"
        },
        {
          "command": "ensemble.kit.new",
          "when": "view == ensemble.project && viewItem == section.kits",
          "group": "inline"
        },
        {
          "command": "ensemble.kit.install",
          "when": "view == ensemble.project && viewItem == section.kits",
          "group": "inline"
        },
        {
          "command": "ensemble.kit.update",
          "when": "view == ensemble.project && viewItem == kit.vendored",
          "group": "inline"
        },
        {
          "command": "ensemble.kit.pin",
          "when": "view == ensemble.project && viewItem == kit.vendored",
          "group": "manage@1"
        },
        {
          "command": "ensemble.kit.contribute",
          "when": "view == ensemble.project && viewItem == kit.vendored",
          "group": "manage@2"
        },
        {
          "command": "ensemble.kit.eject",
          "when": "view == ensemble.project && viewItem == kit.local",
          "group": "manage@1"
        },
        {
          "command": "ensemble.lib.new",
          "when": "view == ensemble.project && viewItem == section.libraries",
          "group": "inline"
        },
        {
          "command": "ensemble.lib.install",
          "when": "view == ensemble.project && viewItem == section.libraries",
          "group": "inline"
        },
        {
          "command": "ensemble.lib.update",
          "when": "view == ensemble.project && viewItem == library.vendored",
          "group": "inline"
        },
        {
          "command": "ensemble.lib.pin",
          "when": "view == ensemble.project && viewItem == library.vendored",
          "group": "manage@1"
        },
        {
          "command": "ensemble.lib.contribute",
          "when": "view == ensemble.project && viewItem == library.vendored",
          "group": "manage@2"
        },
        {
          "command": "ensemble.lib.eject",
          "when": "view == ensemble.project && viewItem == library.local",
          "group": "manage@1"
        },
        {
          "command": "ensemble.lib.publish",
          "when": "view == ensemble.project && viewItem =~ /^library\\./",
          "group": "publish@1"
        },
        {
          "command": "ensemble.kit.uninstall",
          "when": "view == ensemble.project && viewItem == kit.vendored",
          "group": "manage@9"
        },
        {
          "command": "ensemble.lib.uninstall",
          "when": "view == ensemble.project && viewItem == library.vendored",
          "group": "manage@9"
        }
      ],
      "commandPalette": [
        {
          "command": "ensemble.build",
          "when": "false"
        },
        {
          "command": "ensemble.kit.update",
          "when": "false"
        },
        {
          "command": "ensemble.kit.pin",
          "when": "false"
        },
        {
          "command": "ensemble.kit.contribute",
          "when": "false"
        },
        {
          "command": "ensemble.kit.eject",
          "when": "false"
        },
        {
          "command": "ensemble.lib.update",
          "when": "false"
        },
        {
          "command": "ensemble.lib.pin",
          "when": "false"
        },
        {
          "command": "ensemble.lib.contribute",
          "when": "false"
        },
        {
          "command": "ensemble.lib.eject",
          "when": "false"
        },
        {
          "command": "ensemble.lib.publish",
          "when": "false"
        },
        {
          "command": "ensemble.updateCli",
          "when": "false"
        },
        {
          "command": "ensemble.develop",
          "when": "false"
        },
        {
          "command": "ensemble.deploy",
          "when": "false"
        },
        {
          "command": "ensemble.kit.uninstall",
          "when": "false"
        },
        {
          "command": "ensemble.lib.uninstall",
          "when": "false"
        }
      ]
    }
  }
}
