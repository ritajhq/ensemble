{
  "name": "@ritaj/ui",
  "exports": {
    ".": "./index.ts",
    "./styles": "./styles.css"
  },
  "imports": {
    "react": "npm:react@19.2.0",
    "react-dom": "npm:react-dom@19.2.0",
    "framer-motion": "npm:framer-motion@14.0.0",
    "class-variance-authority": "npm:class-variance-authority@0.7.1",
    "clsx": "npm:clsx@2.1.1",
    "tailwind-merge": "npm:tailwind-merge@3.7.0",
    "@base-ui/react": "npm:@base-ui/react@1.8.0",
    "@base-ui/react/": "npm:/@base-ui/react@1.8.0/",
    "@radix-ui/react-accordion": "npm:@radix-ui/react-accordion@1.2.20",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@1.3.3",
    "@radix-ui/react-dropdown-menu": "npm:@radix-ui/react-dropdown-menu@2.1.24",
    "@radix-ui/react-checkbox": "npm:@radix-ui/react-checkbox@1.3.11",
    "@radix-ui/react-radio-group": "npm:@radix-ui/react-radio-group@1.4.7",
    "@radix-ui/react-dialog": "npm:@radix-ui/react-dialog@1.1.23",
    "@radix-ui/react-tabs": "npm:@radix-ui/react-tabs@1.1.21",
    "@radix-ui/react-switch": "npm:@radix-ui/react-switch@1.3.7",
    "@radix-ui/react-slider": "npm:@radix-ui/react-slider@1.4.7",
    "@radix-ui/react-scroll-area": "npm:@radix-ui/react-scroll-area@1.2.18",
    "@radix-ui/react-select": "npm:@radix-ui/react-select@2.3.7",
    "@radix-ui/react-popover": "npm:@radix-ui/react-popover@1.1.23",
    "@radix-ui/react-tooltip": "npm:@radix-ui/react-tooltip@1.2.16",
    "@radix-ui/react-collapsible": "npm:@radix-ui/react-collapsible@1.1.20",
    "@untitledui/icons": "npm:@untitledui/icons@0.0.23",
    "@std/path": "jsr:@std/path@1.1.6"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.window"
    ],
    "types": [
      "npm:@types/react@19.2.17",
      "npm:@types/react-dom@19.2.3"
    ]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "trailingCommas": "onlyMultiLine"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
